KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=mydata
DATABASE_URL=postgresql+psycopg2://mydata:mydata@localhost:5433/subscriptions_db
CORS_ORIGINS=http://localhost:3000,http://localhost:3010
INTERNAL_API_TOKEN=mydata-internal-dev-token

LOG_LEVEL=INFO
LOG_DIR=logs
LOG_TO_FILE=true
LOG_MAX_BYTES=10485760
